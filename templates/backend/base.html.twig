<!DOCTYPE html>
<html lang="en">
  <head>
    {% block head %}
      <title>{% block title %}{% endblock %} - SMC</title>
    {% endblock %}
  </head>
  <body>
    {% set flashMessage = flashGetMessage() %}
    {% if flashMessage %}
      {% do flashDeleteMessage() %}
      <div id="flash-message">
        {{ flashMessage }}
      </div>
    {% endif %}
    <div id="content">
      {% block content %}{% endblock %}
    </div>
  </body>
</html>
