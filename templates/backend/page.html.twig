{% extends "@backend/base.html.twig" %}

{% block title %}Page{% endblock %}

{% block content %}
  <h1>Editing: {{ page.title }}</h1>
  <form action="/page/{{ page.pageID }}/" method="post">
    <label>
      <input type="text" name="title" value="{{ page.title }}" placeholder="Title" />
    </label>
    <br>
    <label>
      <input type="text" name="slug" value="{{ page.slug }}" placeholder="slug" />
    </label>
    <br>
    <input type="hidden" name="{{ csrfTokenName() }}" value="{{ csrfTokenValue() }}" />
    <input type="submit" value="Save the page" />
  </form>
{% endblock %}
