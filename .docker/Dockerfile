# MultiStage - PHP libraries
FROM composer:2 AS composer
COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --no-dev
COPY . .
RUN composer dumpautoload -a --no-dev

# MultiStage - PHP Webserver
FROM php:8.5.10-apache-trixie

# User / permissions setup.

# 1/3 - Change GID of dialout group from 20 to 31, because MacOS uses group 20 as the default.
RUN groupmod -g 31 dialout

# 2/5 Get UID for www-data from build arguments. Default to 33.
ARG WWWUID=33
# 3/5 Get GID for www-data from build arguments. Default to 33.
ARG WWWGID=33

# 4/5 Set environment variables based on build arguments
ENV WWWUID=${WWWUID}
ENV WWWGID=${WWWGID}

# 5/5 Set www-data user and group to match build arguments
RUN groupmod -g ${WWWGID} www-data
RUN usermod -u ${WWWUID} www-data

# Install extensions
RUN apt-get update \
    && apt-get install -y apt-utils


RUN apt-get install -y libzip-dev zip libicu-dev \
    && docker-php-ext-configure zip \
    && docker-php-ext-configure intl \
    && docker-php-ext-install zip intl bcmath

# OPCache
# RUN docker-php-ext-install opcache && docker-php-ext-configure opcache --enable-opcache
COPY ./.docker/config/opcache.ini $PHP_INI_DIR/conf.d/
COPY ./.docker/config/opcache-blacklist.txt $PHP_INI_DIR/opcache-blacklist.txt


# Copy web files
COPY ./public/index.php /app/public/index.php

# Copy other stuff.
COPY ./src /app/src
COPY ./migrations /app/migrations
COPY ./commands /app/commands

# Make directories
RUN mkdir -p /app/public/files
RUN chown -R www-data:www-data /app/public/files

RUN mkdir -p /app/sqlite
RUN chown -R www-data:www-data /app/sqlite

# PHP.ini
COPY ./.docker/config/php.ini $PHP_INI_DIR/php.ini

# Vendor folder from composer
COPY --from=composer /app/vendor /app/vendor


# Apache config

ENV APACHE_DOCUMENT_ROOT=/app/public

# Set to prevent startup errors, not really used for anything on our side.
# AH00558: apache2: Could not reliably determine the server's fully qualified domain name, using X.X.X.X.
RUN echo "ServerName smc" >> /etc/apache2/apache2.conf

# Remove version / linux-distro from server header.
# Before: Server: Apache/2.X.Y (Debian)
# After:  Server: Apache
# It's not possible to turn off the server header completely.
# https://httpd.apache.org/docs/2.4/mod/core.html#servertokens
RUN echo "ServerTokens ProductOnly" >> /etc/apache2/apache2.conf

# Disable server signature on pages generated by Apache (e.g. 404 pages).
RUN echo "ServerSignature Off" >> /etc/apache2/apache2.conf

# Disable sendfile when running as container
RUN echo "EnableSendfile Off" >> /etc/apache2/apache2.conf

# Change default port to 8080
RUN sed -i "s/80/8080/g" /etc/apache2/ports.conf

COPY ./.docker/config/000-default.conf /etc/apache2/sites-available/000-default.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf
# Each container in the same service would try to write to the same file in /tmp = warnings/errors in logs
# /dev/shm/ is a memory/RAM-disk. Write PID here instead.
RUN sed -i 's|^PidFile .*|PidFile /dev/shm/apache2.smc.pid|' /etc/apache2/apache2.conf

# Apache MPM tuning
COPY ./.docker/config/apache-mpm.conf /etc/apache2/conf-available/mpm-tuning.conf
RUN a2enconf mpm-tuning

RUN a2enmod rewrite
RUN a2enmod headers

# Don't run as root
USER www-data

