{
  "name": "kbergha/smc",
  "description": "Simple Manager of Content",
  "type": "project",
  "license": "UNLICENSE",
  "prefer-stable": true,
  "require": {
    "twig/twig": "v3.30.0",
    "ext-pdo": "*",
    "ext-sqlite3": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "Smc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.10",
      "ext-json": "1",
      "ext-zip": "1",
      "ext-bcmath": "1",
      "ext-intl": "1",
      "ext-mbstring": "1",
      "ext-sqlite3": "1",
      "ext-uri": "1",
      "ext-tidy": "1",
      "ext-pdo": "1"
    },
    "policy": {
      "advisories": {
        "ignore-severity": ["low"]
      },
      "abandoned": {
        "block": true
      }
    }
  }
}
